{
  "name": "david-lira-fx-replay",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/.bin/astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/.bin/vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/vercel": "^11.0.10",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^7.3.3",
    "drizzle-orm": "^0.45.2",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
