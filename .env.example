# Copy to .env and fill in. Never commit .env — it's gitignored.
# Only PUBLIC_* variables reach the browser; everything else stays server-side.

# Neon Postgres connection string, used by Drizzle (src/lib/db).
# Use the POOLED connection ("-pooler" in the host) — serverless functions open
# a new connection per invocation and the direct URL runs out of them.
# Neon > project > Connection Details > Pooled connection.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Bearer token guarding the admin surfaces: GET /api/users and /dashboard.
# Those responses contain PII, so this is the only thing between the funnel
# data and the open internet. Generate a random one, never reuse a password:
#   openssl rand -base64 32
ADMIN_TOKEN=""

# Google Tag Manager container ID. PUBLIC_ because it's injected into the page;
# it's not a secret. Leave empty in local dev to skip loading GTM entirely.
# Format: GTM-XXXXXXX
PUBLIC_GTM_ID=""

# GA4 measurement ID for the Measurement Protocol call that sends
# `account_created` server-side. Not the GTM ID. Format: G-XXXXXXXXXX.
# GA4 > Admin > Data streams > your web stream.
GA4_MEASUREMENT_ID=""

# API secret for that same Measurement Protocol call. This IS a secret: it
# lets anyone write events into the property. Server-side only, never PUBLIC_.
# GA4 > Admin > Data streams > your stream > Measurement Protocol API secrets.
GA4_API_SECRET=""
