{
  "disableClaudeAiConnectors": true,
  "enabledMcpjsonServers": [
    "mobbin",
    "playwright"
  ],
  "enabledPlugins": {
    "vercel@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npx astro check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(gh:*)"
    ]
  }
}
