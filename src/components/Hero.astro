---
import type { VariantCopy } from '../content/variants';
import { SHARED_COPY } from '../content/shared';
import Cta from './Cta.astro';
import HeroChart from './HeroChart.astro';

interface Props {
	copy: VariantCopy;
}

const { copy } = Astro.props;
---

<section class="hero">
	<div class="container hero__inner">
		<div class="hero__copy">
			<h1 class="hero__headline">{copy.hero.headline}</h1>
			<p class="hero__sub">{copy.hero.subheadline}</p>

			<div class="hero__actions">
				<Cta label={SHARED_COPY.primaryCta} location="hero" block />
				<Cta
					label={SHARED_COPY.transitionalCta}
					location="hero"
					variant="transitional"
					href="#plan-preview"
					block
				/>
			</div>

			<p class="hero__trust">{SHARED_COPY.trustLine}</p>
		</div>

		<!-- Below the CTA on mobile so the H1 is the LCP and the action stays
		     above the fold; beside it from 64rem up. -->
		<div class="hero__visual">
			<HeroChart />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-8) var(--section-pad);
	}

	.hero__inner {
		display: grid;
		gap: var(--space-7);
	}

	.hero__headline {
		font-size: var(--text-display);
		letter-spacing: var(--tracking-tight);
	}

	.hero__sub {
		margin-top: var(--space-5);
		max-width: 34rem;
		color: var(--text-secondary);
		font-size: var(--text-lg);
	}

	.hero__actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.hero__trust {
		margin-top: var(--space-4);
		color: var(--text-secondary);
		font-size: var(--text-sm);
	}

	@media (min-width: 30rem) {
		.hero__actions {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.hero__actions :global(.cta) {
			width: auto;
		}
	}

	@media (min-width: 64rem) {
		.hero__inner {
			grid-template-columns: 55fr 45fr;
			align-items: center;
			gap: var(--space-8);
		}
	}
</style>
