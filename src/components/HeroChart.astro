---
/**
 * Decorative hero visual: a stylised replay of a historical session.
 *
 * A plain candlestick chart would say "trading". What we sell is *replay*, so
 * the visual says control of time: candles left of the playhead are solid
 * (already happened), candles to the right are hollow ghosts (not yet played).
 *
 * Inline SVG on purpose — no network request, no layout shift (fixed viewBox),
 * no dependency on product screenshots we do not have.
 *
 * aria-hidden: the meaning is carried by the headline next to it. A screen
 * reader gains nothing from a described decoration.
 */

// x, open, close, low, high in viewBox units. Hand-tuned to read as a plausible
// session rather than generated noise.
const past = [
	{ x: 16, o: 108, c: 96, l: 92, h: 112 },
	{ x: 34, o: 96, c: 104, l: 93, h: 108 },
	{ x: 52, o: 104, c: 88, l: 84, h: 106 },
	{ x: 70, o: 88, c: 78, l: 74, h: 90 },
	{ x: 88, o: 78, c: 86, l: 75, h: 90 },
	{ x: 106, o: 86, c: 72, l: 68, h: 88 },
	{ x: 124, o: 72, c: 64, l: 58, h: 76 },
	{ x: 142, o: 64, c: 74, l: 61, h: 78 },
	{ x: 160, o: 74, c: 58, l: 52, h: 77 },
	{ x: 178, o: 58, c: 48, l: 44, h: 62 },
	{ x: 196, o: 48, c: 56, l: 45, h: 60 },
	{ x: 214, o: 56, c: 42, l: 38, h: 58 },
];

const future = [
	{ x: 244, o: 42, c: 50, l: 39, h: 54 },
	{ x: 262, o: 50, c: 38, l: 34, h: 52 },
	{ x: 280, o: 38, c: 46, l: 35, h: 50 },
	{ x: 298, o: 46, c: 32, l: 28, h: 48 },
	{ x: 316, o: 32, c: 40, l: 29, h: 44 },
	{ x: 334, o: 40, c: 26, l: 22, h: 42 },
];

const PLAYHEAD_X = 230;
const BODY_W = 10;

const body = (c: { o: number; c: number }) => ({
	y: Math.min(c.o, c.c),
	height: Math.max(Math.abs(c.o - c.c), 2),
});
---

<div class="chart">
	<svg
		class="chart__svg"
		viewBox="0 0 360 140"
		fill="none"
		aria-hidden="true"
		focusable="false"
	>
		<!-- Already played: solid, directional colour. -->
		{
			past.map((c) => {
				const up = c.c <= c.o;
				const stroke = up ? 'var(--success)' : 'var(--error)';
				const { y, height } = body(c);
				return (
					<g>
						<line
							x1={c.x}
							y1={c.h}
							x2={c.x}
							y2={c.l}
							stroke={stroke}
							stroke-width="1.5"
						/>
						<rect
							x={c.x - BODY_W / 2}
							y={y}
							width={BODY_W}
							height={height}
							rx="1.5"
							fill={stroke}
						/>
					</g>
				);
			})
		}

		<!-- Not yet played: hollow, neutral. Never brand blue — this is not
		     where FX Replay enters the story (D24). -->
		{
			future.map((c) => {
				const { y, height } = body(c);
				return (
					<g class="chart__future">
						<line
							x1={c.x}
							y1={c.h}
							x2={c.x}
							y2={c.l}
							stroke="var(--dark-400)"
							stroke-width="1.5"
						/>
						<rect
							x={c.x - BODY_W / 2}
							y={y}
							width={BODY_W}
							height={height}
							rx="1.5"
							fill="none"
							stroke="var(--dark-400)"
							stroke-width="1.5"
						/>
					</g>
				);
			})
		}

		<!-- The playhead is the whole idea: you decide when the next candle prints. -->
		<g class="chart__playhead">
			<line
				x1={PLAYHEAD_X}
				y1="8"
				x2={PLAYHEAD_X}
				y2="132"
				stroke="var(--border-brand)"
				stroke-width="2"
			/>
			<rect
				x={PLAYHEAD_X - 5}
				y="4"
				width="10"
				height="10"
				rx="3"
				fill="var(--border-brand)"
			/>
		</g>
	</svg>

	<p class="chart__chip">
		<span class="chart__dot" aria-hidden="true"></span>
		Replaying EUR/USD · 2019 session
	</p>
</div>

<style>
	.chart {
		position: relative;
		padding: var(--space-5) var(--space-4) var(--space-4);
		background: var(--card-bg-secondary);
		border: 1px solid var(--border-primary);
		border-radius: var(--radius-lg);
		/* Brand wash behind the chart: the guide's presence, not decoration. */
		background-image: radial-gradient(
			120% 80% at 65% 0%,
			var(--brand-wash-faint),
			transparent 70%
		);
	}

	.chart__svg {
		width: 100%;
		height: auto;
	}

	.chart__future {
		opacity: 0.55;
	}

	.chart__chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-3);
		padding: var(--space-2) var(--space-3);
		background: var(--bg-primary);
		border: 1px solid var(--border-secondary);
		border-radius: var(--radius-full);
		color: var(--text-secondary);
		font-size: var(--text-sm);
	}

	.chart__dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: var(--radius-full);
		background: var(--border-brand);
	}

	/* One pass of the playhead on load, then it rests. No JS, and it stops
	   entirely for anyone who asked for less motion. */
	@media (prefers-reduced-motion: no-preference) {
		.chart__playhead {
			animation: playhead-sweep 2.4s ease-out 0.3s both;
		}
	}

	@keyframes playhead-sweep {
		from {
			transform: translateX(-90px);
			opacity: 0;
		}
		to {
			transform: translateX(0);
			opacity: 1;
		}
	}
</style>
