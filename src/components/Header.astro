---
import { SHARED_COPY } from '../content/shared';
import Cta from './Cta.astro';
---

<header class="header">
	<div class="container header__inner">
		<a href="/" class="header__logo" aria-label="FX Replay home">
			<img src="/brand/isotypeWhite.svg" alt="" width="24" height="24" />
			<span>FX Replay</span>
		</a>
		<Cta label={SHARED_COPY.primaryCta} location="header" class="header__cta" />
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg-primary) 85%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-primary);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		/* Roomier than the 3.5rem it was: the CTA is 3rem tall, so the old
		   header left it 4px of breathing room top and bottom. */
		min-height: 4.25rem;
		padding-block: var(--space-3);
	}

	.header__logo {
		display: inline-flex;
		align-items: center;
		/* 44px touch target (CLAUDE.md). An inline link wrapping a 24px icon
		   and a line of text lands around 26px on its own. */
		min-height: 2.75rem;
		gap: var(--space-2);
		color: var(--text-primary);
		font-family: var(--font-heading);
		font-weight: var(--weight-heading);
		text-decoration: none;
	}

	/* The hero CTA is right there on small screens; a second one in the header
	   would be two competing primary actions in one viewport.
	 *
	 * :global() is required, not stylistic. Astro scopes styles by adding this
	 * component's id to elements in *its own* template; the CTA's root <a> is
	 * rendered by Cta.astro and carries only Cta's id, so a plain .header__cta
	 * rule compiles to a selector that matches nothing and fails silently.
	 * Kept under .header__inner > so the escape hatch cannot reach further
	 * than this header. */
	/* Mobile: hidden while the hero is on screen, shown once it has scrolled
	 * past (experience.md §1 — sticky with a CTA after the hero). The toggle is
	 * data-past-hero on <html>, set by the shared observer in the layout.
	 *
	 * An animation rather than a transition, because the element also changes
	 * `display` and transitions do not run across that. */
	.header__inner > :global(.header__cta) {
		display: none;
	}

	:global(html[data-past-hero]) .header__inner > :global(.header__cta) {
		display: inline-flex;
		width: auto;
		min-height: 2.75rem;
		padding-inline: var(--space-4);
		font-size: var(--text-sm);
		/* The label is shared across arms and must not change, so the button
		   never wraps: the logo gives up its wordmark instead (below). */
		white-space: nowrap;
		animation: header-cta-in 220ms ease-out both;
	}

	/* Once the CTA appears on a phone there is not room for both. The link
	   keeps its aria-label, so its accessible name is unchanged. */
	@media (max-width: 47.99rem) {
		:global(html[data-past-hero]) .header__logo span {
			display: none;
		}

		:global(html[data-past-hero]) .header__logo {
			min-width: 2.75rem;
			justify-content: center;
		}
	}

	@keyframes header-cta-in {
		from {
			opacity: 0;
			transform: translateY(-0.4rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html[data-past-hero]) .header__inner > :global(.header__cta) {
			animation: none;
		}
	}

	@media (min-width: 48rem) {
		.header__inner > :global(.header__cta) {
			display: inline-flex;
			/* Slightly shorter and tighter than a section CTA: a navbar button
			   that matches the hero button competes with it. */
			width: auto;
			min-height: 2.75rem;
			padding-inline: var(--space-5);
			font-size: var(--text-sm);
		}
	}
</style>
