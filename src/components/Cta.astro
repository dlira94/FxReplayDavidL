---
/**
 * The page has exactly one primary action. Every CTA points at #plan, where the
 * quiz mounts in block 3; until then the anchor simply scrolls to the section.
 *
 * `location` is carried as a data attribute so the analytics layer can read
 * which CTA was clicked without each call site knowing about tracking.
 */
interface Props {
	label: string;
	variant?: 'primary' | 'transitional';
	location: 'header' | 'hero' | 'plan_preview' | 'final';
	href?: string;
	block?: boolean;
	class?: string;
}

const {
	label,
	variant = 'primary',
	location,
	href = '#plan',
	block = false,
	class: className,
} = Astro.props;
---

<a
	href={href}
	class:list={['cta', `cta--${variant}`, block && 'cta--block', className]}
	data-cta-location={location}
>
	{label}
</a>

<style>
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		/* 48px floor: comfortably over the 44px touch-target minimum. */
		min-height: 3rem;
		padding: var(--space-3) var(--space-6);
		border-radius: var(--radius-md);
		font-weight: var(--weight-emphasis);
		text-align: center;
		text-decoration: none;
		transition:
			background-color var(--transition-fast),
			border-color var(--transition-fast);
	}

	/* Full width on phones: a thumb-width target, and every CTA on the page
	   reads as the same object instead of three different sizes. */
	.cta {
		width: 100%;
	}

	@media (min-width: 30rem) {
		.cta {
			width: auto;
		}

		.cta--block {
			width: 100%;
		}
	}

	/* Brand blue marks the call to action: where the guide asks you to act (D24).
	 *
	 * The border is a conic gradient of the brand blues that travels around the
	 * edge once on load and once more on hover or focus. Never a loop: a button
	 * that shimmers forever stops reading as "press me" and starts reading as
	 * decoration, which is the one thing D24 rules out.
	 *
	 * Built with padding-box/border-box rather than a pseudo-element, so there
	 * is no extra box to mask and nothing to mis-stack. --cta-angle is a
	 * registered property; browsers without @property simply get the static
	 * gradient, which still looks intentional. */
	.cta--primary {
		background:
			linear-gradient(
					var(--btn-bg-primary-active),
					var(--btn-bg-primary-active)
				)
				padding-box,
			conic-gradient(
					from var(--cta-angle),
					var(--blue-800) 0deg 200deg,
					var(--blue-300) 290deg,
					var(--blue-400) 360deg
				)
				border-box;
		border: 1.5px solid transparent;
		color: var(--btn-text);
	}

	.cta--primary:hover {
		background:
			linear-gradient(var(--btn-bg-primary-hover), var(--btn-bg-primary-hover))
				padding-box,
			conic-gradient(
					from var(--cta-angle),
					var(--blue-800) 0deg 200deg,
					var(--blue-300) 290deg,
					var(--blue-400) 360deg
				)
				border-box;
	}

	.cta--primary:active {
		background:
			linear-gradient(
					var(--btn-bg-primary-pressed),
					var(--btn-bg-primary-pressed)
				)
				padding-box,
			conic-gradient(var(--blue-800), var(--blue-800)) border-box;
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta--primary {
			animation: cta-sweep 1400ms ease-out 400ms 1;
		}

		.cta--primary:hover,
		.cta--primary:focus-visible {
			animation: cta-sweep 900ms ease-out 1;
		}
	}

	@keyframes cta-sweep {
		from {
			--cta-angle: 0deg;
		}
		to {
			--cta-angle: 360deg;
		}
	}

	.cta--transitional {
		background: var(--btn-bg-outline-active);
		color: var(--text-primary);
		border: 1px solid var(--btn-border-outline);
	}

	.cta--transitional:hover {
		background: var(--btn-bg-outline-hover);
	}

	.cta--transitional:active {
		background: var(--btn-bg-outline-pressed);
	}
</style>
