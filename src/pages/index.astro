---
// Rendered on demand so the middleware can assign a variant per request
// (decision D16). Prerendering would run the middleware at build time, where
// there is no request to vary on.
export const prerender = false;

import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import Guide from '../components/Guide.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Outcome from '../components/Outcome.astro';
import PlanPreview from '../components/PlanPreview.astro';
import QuizMount from '../components/QuizMount.astro';
import Problem from '../components/Problem.astro';
import SocialProof from '../components/SocialProof.astro';
import Testimonials from '../components/Testimonials.astro';
import { getVariantCopy } from '../content/variants';
import Landing from '../layouts/Landing.astro';
import { CONTROL_VARIANT } from '../lib/variants';

// Falls back to the control rather than blanking if the middleware somehow did
// not run: a wrong arm is recoverable, a broken landing is not.
const variant = Astro.locals.variant ?? CONTROL_VARIANT;
const isQa = Astro.locals.isQa ?? true;
const copy = getVariantCopy(variant);

// First-touch UTMs, read from the URL the visitor landed on. The middleware
// already stored them with the exposure; these ride along with the signup.
const params = Astro.url.searchParams;
const utm = {
	utmSource: params.get('utm_source'),
	utmMedium: params.get('utm_medium'),
	utmCampaign: params.get('utm_campaign'),
	utmContent: params.get('utm_content'),
	utmTerm: params.get('utm_term'),
};
---

<Landing variant={variant} isQa={isQa}>
	<Header />

	<main id="main" data-variant={variant} data-qa={String(isQa)}>
		{/* StoryBrand order — docs/experience.md §1 */}
		<Hero copy={copy} />
		<SocialProof />
		<Problem copy={copy} />
		<Guide />
		<PlanPreview copy={copy} />
		<HowItWorks />
		<Outcome />
		<Testimonials />
		<Faq />
		<FinalCta copy={copy} />

		<QuizMount
			variant={variant}
			copy={copy}
			isQa={isQa}
			anonymousId={Astro.locals.anonymousId ?? ''}
			utm={utm}
		/>
	</main>

	<Footer />
</Landing>
